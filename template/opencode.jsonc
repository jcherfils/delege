// OpenCode 2 configuration of this repository's delegated agents (https://github.com/jcherfils/delege): a local
// model only, through Ollama. With cloud models (delege run --cloud), delege writes a copy of this file into each
// task's worktree whose provider policies allow exactly the free providers in use; this copy stays Ollama-only.
// Format: https://opencode.ai/v2/docs/config/ — `providers`, `permissions` (ordered rules, the last match wins),
// `policies` (hard allow / deny that no agent can loosen), `update`. The agents are in .opencode/agents/*.md
// (generated by `delege init` from delege.toml).
{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:14b",
  "update": "disable",
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:14b": {
          "name": "Qwen3 14B (local, Q4_K_M)",
          "limit": {
            "context": 40960,
            "output": 8192
          }
        }
      }
    }
  },
  "agents": {
    "title": {
      "model": "ollama/qwen3:14b"
    }
  },
  "policies": [
    {"action": "provider.use", "resource": "*", "effect": "deny"},
    {"action": "provider.use", "resource": "ollama", "effect": "allow"},
    {"action": "tool.use", "resource": "shell:git push *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:git commit *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:git reset --hard *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:git rebase *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:curl *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:wget *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:pip install *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:uv pip install *", "effect": "deny"},
    {"action": "tool.use", "resource": "websearch:*", "effect": "deny"}
  ],
  "permissions": [
    {"action": "shell", "resource": "*", "effect": "ask"},
    {"action": "shell", "resource": "git push *", "effect": "deny"},
    {"action": "shell", "resource": "git commit *", "effect": "deny"},
    {"action": "shell", "resource": "git reset --hard *", "effect": "deny"},
    {"action": "shell", "resource": "git rebase *", "effect": "deny"},
    {"action": "shell", "resource": "rm -rf *", "effect": "deny"},
    {"action": "shell", "resource": "curl *", "effect": "deny"},
    {"action": "shell", "resource": "wget *", "effect": "deny"},
    {"action": "shell", "resource": "pip install *", "effect": "deny"},
    {"action": "shell", "resource": "uv pip install *", "effect": "deny"},
    {"action": "read", "resource": "*/.config/delege/*", "effect": "deny"},
    {"action": "read", "resource": "~/.config/delege/*", "effect": "deny"},
    {"action": "read", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "read", "resource": "~/.ssh/*", "effect": "deny"},
    {"action": "webfetch", "resource": "*", "effect": "deny"},
    {"action": "websearch", "resource": "*", "effect": "deny"},
    {"action": "external_directory", "resource": "*", "effect": "deny"}
  ]
}
